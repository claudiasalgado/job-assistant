# Copia este fichero a .env y rellena los valores. .env no se sube a git.

# Proyecto de GCP donde se factura y se ejecuta Vertex AI
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp

# Bucket de Cloud Storage donde van los ficheros de cada candidatura
GCS_BUCKET=clau-job-assistant

# Topic de Pub/Sub donde la api publica los trabajos para el worker
TASKS_TOPIC=cv-tasks

# Región de Vertex AI (europe-west4 = Países Bajos, procesamiento en la UE)
GOOGLE_CLOUD_LOCATION=europe-west4

# Usar Vertex AI (con credenciales ADC) en vez de la API con clave
GOOGLE_GENAI_USE_ENTERPRISE=true

# Solo en macOS con Homebrew: dónde están pango y gobject, que necesita WeasyPrint.
# Va aquí porque uv run no hereda las variables DYLD_* de la terminal.
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib

# Modelo de Gemini. Va aquí y no en el código porque se queda obsoleto.
# gemini-3.8-flash no estaba disponible en europe-west4 (ver decisión 005)
GEMINI_MODEL=gemini-2.5-flash
